# .env ของเซิร์ฟเวอร์ production (/opt/lottery/.env) — docker/setup-server.sh สร้างให้อัตโนมัติ (สุ่มรหัสผ่าน)
# ไฟล์นี้เป็นตัวอย่าง/อ้างอิงเท่านั้น ห้าม commit ค่าจริง

# ---------- ที่อยู่ที่ browser ใช้เข้าถึง ----------
# "http://:พอร์ต" = รับทุก host/IP (วงแลน + public IP ผ่าน port-forward) — ถ้าใส่ IP ตรง ๆ host อื่นจะได้หน้าขาว
# พอร์ต 3002 ผูกไว้ใน docker-compose.prod.yml (SACDMS ใช้ 3001 อยู่แล้ว)
APP_SITE="http://:3002"

# เข้าผ่านโดเมนของ "เซิร์ฟเวอร์อื่น" ที่ทำ HTTPS แล้วส่งต่อมาที่ http://<IP นี้>:3002 — ดู DEPLOY.md
# TRUSTED_PROXIES="203.0.113.10"        # IP ของเซิร์ฟเวอร์นั้น (ที่ต่อเข้ามาหาเรา) — หลายค่าคั่นด้วยช่องว่าง

# ---------- Image ----------
# deploy บันทึกค่า tag ของ commit ล่าสุดไว้ให้เอง — rollback ด้วยมือได้ด้วยการตั้งเป็น tag ของ commit ก่อนหน้า
# APP_IMAGE="ghcr.io/khamta/lottery:sha-1a2b3c4"
# OCR_IMAGE="ghcr.io/khamta/lottery-ocr:sha-1a2b3c4"

# ---------- Database ----------
POSTGRES_USER="lottery"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="lottery"

# ---------- Auth.js ----------
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET="change-me"

# ---------- อ่านรูปโพยด้วย Claude (ไม่บังคับ — ไม่ใส่ = ใช้บริการ ocr อย่างเดียวตามเดิม) ----------
# key จาก https://console.anthropic.com → API Keys · ใส่แล้ว: sudo -u lottery docker compose -f docker-compose.prod.yml up -d worker
# Claude อ่านไม่ได้ / เครดิตหมด / ติดต่อไม่ได้ → ใช้บริการ ocr แทนอัตโนมัติ แล้วกลับมาใช้ Claude เอง — ดู DEPLOY.md
# ANTHROPIC_API_KEY="sk-ant-..."
# CLAUDE_OCR_MODEL="claude-sonnet-5-5"        # รุ่นถูกที่อ่านทุกรูปก่อน (ค่าเริ่มต้น)
# CLAUDE_OCR_STRONG_MODEL="claude-opus-5-5"   # อ่านซ้ำเมื่อรุ่นถูกอ่านไม่ผ่าน (ค่าเริ่มต้น · "" = ไม่อ่านซ้ำ)
# ---------- อ่านรูปโพยด้วย Ollama Cloud (ไม่บังคับ — ใช้คู่กับ Claude ได้ แม่หวยเลือกรุ่นเองที่หน้าแม่หวย) ----------
# key จาก https://ollama.com/settings/keys · ดู DEPLOY.md หัวข้อ "อ่านรูปโพยด้วย Ollama Cloud"
# OLLAMA_API_KEY="..."
# OCR_MODEL="gemma4:31b"               # รุ่นหลักของโหมดอัตโนมัติ (แทน CLAUDE_OCR_MODEL · ชื่อ claude-* = Claude นอกนั้น = Ollama)
# OCR_CONCURRENCY=4                    # จำนวนรูปที่อ่านพร้อมกัน (ค่าเริ่มต้น 4 · ช่วงใกล้ปิดงวดรูปเยอะ เพิ่มได้ถ้าไม่ติด rate limit)
# OCR_ENHANCE=1                       # ปรับแสง / คอนทราสต์ / ความคมของรูปก่อนให้ AI อ่าน (ค่าเริ่มต้นเปิด · "0" = ส่งรูปเดิม)
# IMAGE_AUTO_ADJUST=1                 # ปรับแสง / ความเข้มของรูปโพยตอนเปิดดู (ไฟล์เก็บต้นฉบับเสมอ · ค่าเริ่มต้นเปิด · "0" = แสดงรูปเดิม)

# ---------- Prisma Studio (http://<IP>:5556, Caddy basic auth) ----------
# deploy สร้างให้อัตโนมัติถ้ายังไม่มี — เปลี่ยนรหัสเอง: ลบ 3 บรรทัดนี้ออกจาก .env แล้ว deploy ใหม่
# STUDIO_USER="admin"
# STUDIO_PASSWORD="..."
# STUDIO_PASSWORD_HASH='$2a$14$...'   (bcrypt — ต้องครอบด้วย ' ')
