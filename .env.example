# ---------- Database (PostgreSQL ใน Docker — docker compose up -d) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/lottery_db?schema=public"

# ---------- Auth.js ----------
# สร้างด้วย: npx auth secret   หรือ  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="My App"
# ชื่อย่อใต้ไอคอนตอนติดตั้งเป็นแอป (PWA) — ไม่ใส่จะใช้ NEXT_PUBLIC_APP_NAME
# NEXT_PUBLIC_APP_SHORT_NAME="MyApp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# เขตเวลาที่ใช้แสดงวันที่/เวลาทั้งระบบ (ค่าเริ่มต้น Asia/Vientiane)
NEXT_PUBLIC_TIME_ZONE="Asia/Vientiane"

# ---------- Docker (docker compose up -d --build) ----------
# พอร์ตของเว็บบนเครื่อง (3000 อาจชนกับโปรเจกต์อื่น) และ URL ที่ฝังตอน build image
APP_PORT=3010
DOCKER_APP_URL="http://localhost:3010"

# ---------- บอท WhatsApp ----------
# ตั้งค่าบัญชี / สแกน QR / เลือกกลุ่ม ที่หน้าเว็บ /whatsapp — ไม่ต้องตั้งใน .env แล้ว
# โฟลเดอร์ session ของบอทเวลารันบนเครื่องด้วย bun run wa:worker (ใน docker ใช้ volume wa-auth)
# WA_AUTH_DIR=".wa-auth"

# ---------- อ่านรูปโพยด้วย AI: Claude และ/หรือ Ollama Cloud (ไม่ใส่ key เลย = อ่านรูปไม่ได้ รูปทุกใบรอคนตรวจ) ----------
# บอทส่งรูปโพยให้ AI อ่าน (src/lottery/image-ai.ts) · ใส่ key ของผู้ให้บริการที่จะใช้ (ใส่ทั้งสองก็ได้ ผสมกันได้)
# เลือกได้ทีละกลุ่มว่าจะอ่านรูปหรือไม่ (หน้า WhatsApp → คอลัมน์ "อ่านรูปโพย") · ไม่อ่าน = เก็บรูปไว้เป็นโพยรอตรวจสอบ
# เครดิตหมด / key ผิด → พักผู้ให้บริการนั้น ลองใหม่เองทุก 30 นาที (ระหว่างนั้นรุ่นอ่านซ้ำของอีกรายอ่านแทน) · ติดต่อไม่ได้ชั่วคราว → ลองใหม่ทุก 30 วินาที
# Claude: สร้าง key ที่ https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."
# Ollama Cloud: สร้าง key ที่ https://ollama.com/settings/keys · OLLAMA_HOST ไม่ต้องตั้ง (ค่าเริ่มต้น https://ollama.com)
# OLLAMA_API_KEY="..."
# OLLAMA_HOST="https://ollama.com"
# ค่าเริ่มต้นของโหมด "อัตโนมัติ" — แม่หวยแต่ละรายเลือกรุ่นหลัก / รุ่นอ่านซ้ำเองได้ที่หน้าแม่หวย
# รุ่นหลักอ่านทุกรูปก่อน (ค่าเริ่มต้น claude-sonnet-5-5) · อ่านไม่ผ่าน (มี ? / ยอดรวมไม่ตรง / โพยยาวไม่มียอดรวม) ให้รุ่นอ่านซ้ำอ่านอีกครั้ง
# (ค่าเริ่มต้น claude-opus-5-5 · ตั้งเป็น "" = ไม่อ่านซ้ำ) · ชื่อรุ่น claude-* = Claude นอกนั้น = Ollama (เช่น gemma4:31b)
# ตัวอย่างประหยัด: OCR_MODEL="gemma4:31b" + OCR_STRONG_MODEL="claude-opus-5-5"
# OCR_MODEL="claude-sonnet-5-5"
# OCR_STRONG_MODEL="claude-opus-5-5"
# จำนวนรูปที่อ่านพร้อมกัน (ค่าเริ่มต้น 4 · Ollama แผน Free ควรลดเหลือ 1-2)
# OCR_CONCURRENCY=4
# ปรับแสง / คอนทราสต์ / ความคมของรูปโพยอัตโนมัติก่อนส่งให้ AI อ่าน (ค่าเริ่มต้นเปิด · "0" = ส่งรูปเดิม)
# OCR_ENHANCE=1
# ปรับแสง / ความเข้มของรูปโพยอัตโนมัติตอนเปิดดูในหน้าโพย — ไฟล์ที่เก็บเป็นต้นฉบับเสมอ (ค่าเริ่มต้นเปิด · "0" = แสดงรูปเดิม)
# IMAGE_AUTO_ADJUST=1
