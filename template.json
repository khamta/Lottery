{
  "$comment": "สัญญาความเป็นเจ้าของไฟล์ระหว่าง template กับ project — ดู docs/EXTENDING.md",
  "name": "nextjs-template",
  "version": "1.1.0",
  "core": [
    "AGENTS.md",
    "docs/**",
    "scripts/**",
    "scaffold/**",
    "src/lib/*.ts",
    "src/lib/validations/auth.ts",
    "src/lib/validations/profile.ts",
    "src/components/**",
    "src/hooks/**",
    "src/types/**",
    "src/middleware.ts",
    "src/styles/themes/**",
    "src/i18n/*.ts",
    "src/i18n/*.tsx",
    "src/i18n/dictionaries/**",
    "src/i18n/modules/define.ts",
    "src/app/*",
    "src/app/api/**",
    "src/app/icons/**",
    "src/app/offline/**",
    "src/app/(auth)/**",
    "src/app/(dashboard)/layout.tsx",
    "src/app/(dashboard)/loading.tsx",
    "src/app/(dashboard)/actions.ts",
    "src/app/(dashboard)/audit-logs/**",
    "src/app/(dashboard)/profile/**",
    "src/app/(dashboard)/settings/**",
    "src/app/(dashboard)/users/**",
    "public/sw.js",
    "public/img/th.jpg",
    "public/img/la.png",
    "public/img/en.png",
    "public/img/china.png",
    "tests/setup.ts",
    "tests/unit/**",
    "tests/components/**",
    "tests/conventions/**",
    "tests/server/presence-actions.test.ts",
    "tests/server/profile-actions.test.ts"
  ],
  "project": [
    "src/config/**",
    "src/styles/brand.css",
    "src/i18n/modules/index.ts",
    "src/i18n/modules/<module>.ts",
    "src/app/(dashboard)/dashboard/**",
    "src/app/(dashboard)/<module>/**",
    "src/lib/validations/<module>.ts",
    "tests/server/<module>-actions.test.ts",
    "prisma/seed.ts",
    "public/**",
    ".env"
  ],
  "shared": ["prisma/schema.prisma", "package.json", "README.md", "CLAUDE.md"],
  "example": [
    "src/app/(dashboard)/products/**",
    "src/lib/validations/product.ts",
    "src/i18n/modules/products.ts",
    "tests/server/product-actions.test.ts"
  ]
}
